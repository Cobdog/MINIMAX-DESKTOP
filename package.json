{
  "name": "minimax-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first web studio for MiniMax H3 video, image and music generation (plus ACE-Step audio) through ComfyUI",
  "author": "James",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm build:web && pnpm start:server",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:server",
    "build:web": "vite build && node scripts/compress-dist.cjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-llm-families.cjs",
    "start:server": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry": "vitest run registry",
    "test:registry:update": "MINIMAX_UPDATE_GOLDEN=1 vitest run registry",
    "test:h3img": "vitest run h3img",
    "test:h3img:update": "MINIMAX_UPDATE_GOLDEN=1 vitest run h3img",
    "test:storage": "vitest run storage",
    "test:documents": "vitest run documents",
    "test:filmstrip": "vitest run filmstrip",
    "test:realtime": "vitest run realtime",
    "test:llm": "vitest run llm",
    "test:engine": "vitest run engine-process",
    "test:runtime": "vitest run runtime",
    "test:fetcher": "vitest run fetcher",
    "test:instance": "vitest run instance",
    "test:poserig": "vitest run poserig",
    "test:camera": "vitest run camera",
    "test:canvas": "vitest run canvas",
    "test:benchmarks": "vitest run benchmarks",
    "test:launcher": "vitest run launcher",
    "test:datasets": "vitest run datasets",
    "test:engine-contract": "vitest run engine-contract",
    "smoke:server": "node scripts/smoke-server.cjs",
    "test:e2e": "pnpm build && playwright test --project=e2e",
    "test:vision": "playwright test --project=vision",
    "vision:report": "node scripts/vision-e2e/report.cjs",
    "gate": "node scripts/run-gate.cjs",
    "license:audit": "node scripts/audit-licenses.cjs",
    "test:all": "pnpm typecheck && pnpm lint && pnpm license:audit && pnpm build && pnpm test && pnpm smoke:server && pnpm test:e2e && pnpm test:vision"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "better-sqlite3": "^13.0.3",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.468.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rnd": "^10.5.3",
    "three": "^0.186.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "pino-pretty": "^13.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
