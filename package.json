{
  "name": "minimax-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first web studio for MiniMax H3, LTX-2.5, ACE-Step and Z-Image generation through ComfyUI",
  "author": "James",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm build:web && pnpm start:server",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:server",
    "build:web": "vite build && node scripts/compress-dist.cjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/test-workflows.cjs",
    "smoke:server": "node scripts/smoke-server.cjs",
    "test:e2e": "pnpm build && playwright test",
    "test:all": "pnpm test && pnpm test:e2e && pnpm smoke:server"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7"
  }
}