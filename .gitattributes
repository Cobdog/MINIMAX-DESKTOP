# Auto detect text files and perform LF normalization
* text=auto
# The committed e2e fixture is a binary — never normalize it.
*.mp4 binary
# Generated benchmark artifacts are byte-compared (LEADERBOARD.md must be
# byte-identical to a fresh regeneration) — pin LF so Windows checkouts with
# core.autocrlf=true cannot diverge from what the generator writes.
benchmarks/results/LEADERBOARD.md text eol=lf
benchmarks/results/registry.json text eol=lf
benchmarks/data/*.json text eol=lf
